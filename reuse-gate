#!/usr/bin/env python3
"""Search-before-build gate. Runtime dependencies: Python 3 standard library, gh."""
import argparse
import fnmatch
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import uuid

DECISIONS = ('adopt', 'extend', 'compose', 'build')
CODE = set('.py .js .mjs .cjs .ts .tsx .jsx .sh .bash .zsh .gd .lua .rb .pl .php .go .rs .c .h .cpp .hpp .java .kt .swift .ps1 .ipynb'.split())
CONFIG = set('.json .yaml .yml .toml .ini .cfg .conf .xml .env .lock'.split())
DENY = ('reuse-gate: new tool/script needs search evidence. In the project root, run '
        'reuse-gate search "<keywords>"; inspect the returned record and its licence/maintenance; '
        'then run reuse-gate decide <record> <adopt|extend|compose|build> "<one-line reason>". '
        'For build, explain why each top candidate does not fit using '
        '"owner/repo: mismatch; owner/repo: mismatch" (top three, or all if fewer). '
        'With no candidates, use "No candidates: <why custom code is needed>". Retry the tool.')


def root(cwd=None):
    path = Path(cwd or os.getcwd()).resolve()
    for parent in (path, *path.parents):
        if (parent / '.git').exists() or (parent / '.reuse-gate').is_dir():
            return parent
    return path


def state(project):
    return project / '.reuse-gate'


def config(project):
    path = state(project) / 'config.json'
    value = json.loads(path.read_text()) if path.exists() else {}
    ttl = value.get('ttl_seconds', 86400)
    globs = value.get('exempt_globs', [])
    if (isinstance(ttl, bool) or not isinstance(ttl, (int, float))
            or not math.isfinite(ttl) or ttl <= 0):
        raise ValueError('ttl_seconds must be a positive finite number')
    if not isinstance(globs, list) or not all(isinstance(g, str) for g in globs):
        raise ValueError('exempt_globs must be a list of strings')
    return ttl, globs


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as f:
            name = f.name
            json.dump(value, f, indent=2, allow_nan=False)
            f.write('\n')
        os.replace(name, path)
    finally:
        if name and os.path.exists(name):
            os.unlink(name)


def check_record(record, ttl, decided=True):
    if not isinstance(record, dict) or record.get('version') != 1:
        return False
    created = record.get('created_at')
    if (isinstance(created, bool) or not isinstance(created, (float, int))
            or not 0 <= time.time() - created < ttl):
        return False
    if not isinstance(record.get('keywords'), str) or not record['keywords'].strip():
        return False
    candidates = record.get('candidates')
    if not isinstance(candidates, list) or len(candidates) > 10:
        return False
    if not all(isinstance(c, dict) and isinstance(c.get('fullName'), str)
               and c['fullName'].count('/') == 1 for c in candidates):
        return False
    if not decided:
        return True
    decision, reason = record.get('decision'), record.get('reason')
    if decision not in DECISIONS or not isinstance(reason, str) or not reason.strip():
        return False
    if '\n' in reason or '\r' in reason:
        return False
    if decision == 'build':
        if not candidates:
            return reason.lower().startswith('no candidates:') and bool(reason[14:].strip())
        # Require a separate named explanation for each top candidate, not a bare name list.
        clauses = reason.lower().split(';')
        for candidate in candidates[:3]:
            prefix = candidate['fullName'].lower() + ':'
            if not any(c.strip().startswith(prefix) and c.strip()[len(prefix):].strip()
                       for c in clauses):
                return False
    return True


def has_record(project, ttl):
    directory = state(project) / 'records'
    try:
        paths = list(directory.iterdir())
    except FileNotFoundError:
        return False
    for path in paths:
        if path.suffix != '.json':
            continue
        try:
            if check_record(json.loads(path.read_text()), ttl):
                return True
        except (ValueError, TypeError):
            continue
    return False


def gated(path, project, globs):
    if path.exists():
        return False
    try:
        relative = path.relative_to(project).as_posix()
    except ValueError:
        relative = path.as_posix()
    parts = relative.lower().split('/')
    name, suffix = path.name.lower(), path.suffix.lower()
    if any(p in {'test', 'tests', '__tests__', 'spec', 'docs', 'doc'} for p in parts[:-1]):
        return False
    if (name.startswith(('test_', '.env')) or path.stem.lower().endswith(('.test', '.spec', '_test', '_spec'))
            or (suffix == '.java' and path.stem.endswith('Test'))
            or suffix in {'.md', '.mdx', '.rst', '.txt', '.adoc'} | CONFIG
            or name in {'makefile', 'dockerfile', '.gitignore', '.editorconfig'}
            or '.config.' in name or name in {'conftest.py', 'setup.cfg'}):
        return False
    if any(fnmatch.fnmatchcase(relative, pattern) for pattern in globs):
        return False
    return suffix in CODE or any(p in {'scripts', 'tools', 'bin', 'addons'} for p in parts[:-1])


def hook(data, diagnostics=None):
    if not isinstance(data, dict):
        raise ValueError('hook input must be an object')
    if diagnostics is None:
        diagnostics = []
    project = root(data.get('cwd'))
    if os.environ.get('REUSE_GATE') == 'off':
        directory = state(project)
        directory.mkdir(parents=True, exist_ok=True)
        with (directory / 'bypass.jsonl').open('a') as log:
            log.write(json.dumps({'time': time.time(), 'event': 'bypass',
                                  'tool': data.get('tool_name')}) + '\n')
        return None
    tool = data.get('tool_name')
    if tool not in {'Write', 'Edit', 'MultiEdit', 'NotebookEdit'}:
        return None
    inputs = data.get('tool_input', {})
    target = inputs.get('notebook_path') if tool == 'NotebookEdit' else inputs.get('file_path')
    if not isinstance(target, str) or not target:
        raise ValueError('missing target path')
    path = Path(target)
    if not path.is_absolute():
        path = Path(data.get('cwd') or os.getcwd()) / path
    # Check both lexical and resolved paths so state symlinks cannot bypass protection.
    path = Path(os.path.abspath(path))
    resolved = path.resolve()
    if any(candidate.is_relative_to(state(project)) for candidate in (path, resolved)):
        return 'reuse-gate: protected .reuse-gate state; use the CLI for searches and decisions.'
    if not gated(resolved, project, []):
        return None
    try:
        ttl, globs = config(project)
    except (OSError, ValueError, TypeError, AttributeError) as error:
        diagnostics.append('invalid/unreadable config; using defaults: ' + str(error))
        ttl, globs = 86400, []
    if gated(resolved, project, globs) and not has_record(project, ttl):
        return DENY
    return None


def emit_denial(reason):
    # Official contract: https://code.claude.com/docs/en/hooks#pretooluse-decision-control
    # JSON on stdout + exit 0; silence leaves normal permissions in force.
    print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse',
          'permissionDecision': 'deny', 'permissionDecisionReason': reason}}))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('hook')
    search = commands.add_parser('search')
    search.add_argument('keywords')
    decide = commands.add_parser('decide')
    decide.add_argument('record', help='record ID printed by search (with optional .json)')
    decide.add_argument('decision', choices=DECISIONS)
    decide.add_argument('reason')
    args = parser.parse_args(argv)
    if args.command == 'hook':
        try:
            diagnostics = []
            reason = hook(json.load(sys.stdin), diagnostics)
            if diagnostics:
                raise ValueError('; '.join(diagnostics))
            if reason:
                emit_denial(reason)
            return 0
        except Exception as error:
            print('reuse-gate: ' + str(error), file=sys.stderr)
            return 1
    try:
        project = root()
        ttl, _ = config(project)
        if args.command == 'search':
            if not args.keywords.strip():
                raise ValueError('keywords must not be empty')
            result = subprocess.run(['gh', 'search', 'repos', *args.keywords.split(), '--sort', 'stars',
                '--limit', '10', '--json', 'fullName,stargazersCount,license,pushedAt,description'],
                capture_output=True, text=True, check=True, timeout=60)
            record = {'version': 1, 'created_at': time.time(), 'keywords': args.keywords,
                      'candidates': json.loads(result.stdout)}
            if not check_record(record, ttl, decided=False):
                raise ValueError('GitHub returned invalid candidates; no record saved')
            identifier = uuid.uuid4().hex
            save(state(project) / 'records' / (identifier + '.json'), record)
            print(json.dumps({'record': identifier, **record}, indent=2))
        else:
            identifier = args.record.removesuffix('.json')
            if len(identifier) != 32 or any(c not in '0123456789abcdef' for c in identifier):
                raise ValueError('use the record ID printed by search')
            path = state(project) / 'records' / (identifier + '.json')
            record = json.loads(path.read_text())
            record.update(decision=args.decision, reason=args.reason.strip())
            if not check_record(record, ttl):
                raise ValueError('invalid/expired record or decision reason. ' + DENY)
            save(path, record)
            print('Decision recorded: ' + identifier)
        return 0
    except (OSError, ValueError, TypeError, AttributeError, subprocess.SubprocessError) as error:
        print('reuse-gate: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
